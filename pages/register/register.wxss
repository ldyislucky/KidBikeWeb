/* ========== 页面容器 ========== */
.page-container {
  min-height: 100vh;
  background: var(--bg);
  padding-top: 40rpx;
}

/* ========== 头部 ========== */
.form-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 40rpx;
}

.header-title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: 2rpx;
}

.header-sub {
  font-size: 26rpx;
  color: #BDC3C7;
  margin-top: 14rpx;
}

/* ========== 表单卡片 ========== */
.form-card {
  background: #fff;
  margin: 24rpx 30rpx;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 107, 0.05);
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F8F0EB;
}

.card-header-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.card-header-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

/* ========== 表单项 ========== */
.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F8F0EB;
}

.form-item.no-border {
  border-bottom: none;
}

.form-label {
  width: 160rpx;
  font-size: 28rpx;
  color: var(--text);
  font-weight: 500;
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.required {
  color: #FF6B6B;
  margin-left: 4rpx;
  font-weight: 700;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
  color: var(--text);
}

.form-input::placeholder {
  color: #BDC3C7;
}

/* ========== 提交按钮 ========== */
.submit-section {
  padding: 40rpx 30rpx 30rpx;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FF6B6B, #FF8E53);
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.3);
}

.submit-text {
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

/* ========== 底部跳转 ========== */
.footer-row {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 30rpx 0 60rpx;
}

.footer-text {
  font-size: 28rpx;
  color: #BDC3C7;
}

.footer-link {
  font-size: 28rpx;
  color: #FF6B6B;
  font-weight: 600;
  margin-left: 8rpx;
}
