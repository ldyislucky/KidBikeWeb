<!-- 注册表单 -->
<view class="page-container">
  <!-- 头部 -->
  <view class="form-header">
    <text class="header-title">创建账号</text>
    <text class="header-sub">注册后可同步收藏、订单等数据</text>
  </view>

  <!-- 基本信息 -->
  <view class="form-card">
    <view class="card-header">
      <text class="card-header-icon">📱</text>
      <text class="card-header-title">账号信息</text>
    </view>
    <view class="form-item">
      <view class="form-label">
        <text>手机号</text>
        <text class="required">*</text>
      </view>
      <input class="form-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" />
    </view>
    <view class="form-item">
      <view class="form-label">
        <text>昵称</text>
        <text class="required">*</text>
      </view>
      <input class="form-input" placeholder="请输入昵称" value="{{nickname}}" bindinput="onNicknameInput" />
    </view>
    <view class="form-item">
      <view class="form-label">
        <text>密码</text>
        <text class="required">*</text>
      </view>
      <input class="form-input" type="password" placeholder="请设置密码（至少6位）" value="{{password}}" bindinput="onPasswordInput" />
    </view>
    <view class="form-item no-border">
      <view class="form-label">
        <text>确认密码</text>
        <text class="required">*</text>
      </view>
      <input class="form-input" type="password" placeholder="请再次输入密码" value="{{confirmPassword}}" bindinput="onConfirmPasswordInput" />
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-section">
    <view class="submit-btn" bindtap="onSubmit">
      <text class="submit-text">注 册</text>
    </view>
  </view>

  <!-- 底部跳转登录 -->
  <view class="footer-row">
    <text class="footer-text">已有账号？</text>
    <text class="footer-link" bindtap="onGoLogin">返回登录</text>
  </view>
</view>
