<view class="page-container">

  <!-- 顶部品牌区 -->
  <view class="brand-header">
    <view class="brand-bg">
      <view class="bg-circle bg-circle-1"></view>
      <view class="bg-circle bg-circle-2"></view>
      <view class="bg-circle bg-circle-3"></view>
    </view>
    <view class="brand-content">
      <text class="brand-logo">🚲</text>
      <text class="brand-name">KidBike</text>
      <text class="brand-sub">欢迎回来</text>
    </view>
  </view>

  <!-- 登录表单 -->
  <view class="form-wrap">
    <view class="form-card">
      <view class="card-title">账号登录</view>

      <!-- 手机号 -->
      <view class="form-item">
        <view class="input-icon-wrap">
          <text class="input-icon iconfont icon-shouji">📱</text>
        </view>
        <input
          class="form-input"
          type="number"
          maxlength="11"
          placeholder="请输入手机号"
          placeholder-class="input-placeholder"
          value="{{phone}}"
          bindinput="onPhoneInput"
        />
      </view>

      <!-- 密码 -->
      <view class="form-item no-border">
        <view class="input-icon-wrap">
          <text class="input-icon">🔒</text>
        </view>
        <input
          class="form-input"
          type="{{showPassword ? 'text' : 'password'}}"
          placeholder="请输入密码"
          placeholder-class="input-placeholder"
          value="{{password}}"
          bindinput="onPasswordInput"
        />
        <view class="eye-btn" bindtap="onTogglePassword">
          <text class="eye-icon">{{showPassword ? '🙈' : '👁'}}</text>
        </view>
      </view>
    </view>

    <!-- 登录按钮 -->
    <view class="submit-section">
      <view
        class="submit-btn {{submitting ? 'submitting' : ''}}"
        bindtap="onSubmit"
      >
        <text class="submit-text">{{submitting ? '登录中...' : '立即登录'}}</text>
      </view>
    </view>

    <!-- 底部注册入口 -->
    <view class="footer-row">
      <text class="footer-text">还没有账号？</text>
      <text class="footer-link" bindtap="onGoRegister">立即注册</text>
    </view>
  </view>

</view>
