.page-container { padding-bottom: 40rpx; min-height: 100vh; background: #FFF5F0; }

/* ========== 通用居中状态 ========== */
.center-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 160rpx 0; font-size: 28rpx; color: #BDC3C7; }
.error-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.retry-btn { margin-top: 24rpx; padding: 14rpx 48rpx; background: linear-gradient(135deg, #FF6B6B, #FF8E53); color: #fff; border-radius: 36rpx; font-size: 26rpx; }
.spinner { width: 56rpx; height: 56rpx; border: 4rpx solid #F0EDEA; border-top-color: #FF6B6B; border-radius: 50%; animation: spin 0.8s linear infinite; margin-bottom: 20rpx; }
@keyframes spin { to { transform: rotate(360deg); } }

/* ========== 关于内容 ========== */
.about-content { display: flex; flex-direction: column; align-items: center; padding: 60rpx 30rpx; }
.about-logo { font-size: 100rpx; margin-bottom: 20rpx; }
.about-brand { font-size: 36rpx; font-weight: 700; color: #2D3436; margin-bottom: 6rpx; }
.about-ver { font-size: 24rpx; color: #BDC3C7; margin-bottom: 40rpx; }
.about-card { background: #fff; width: 100%; border-radius: 20rpx; padding: 28rpx; box-shadow: 0 4rpx 20rpx rgba(255,107,107,0.05); }
.about-text { font-size: 28rpx; color: #636E72; line-height: 1.8; }
.about-info-grid { display: flex; flex-direction: column; gap: 20rpx; margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid #F8F0EB; }
.about-info-item { display: flex; justify-content: space-between; align-items: center; }
.info-label { font-size: 26rpx; color: #BDC3C7; }
.info-value { font-size: 26rpx; color: #2D3436; font-weight: 500; max-width: 60%; text-align: right; }
