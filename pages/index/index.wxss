/* ========== 顶部导航 ========== */
.header {
  position: relative;
  background: linear-gradient(160deg, #FF6B6B 0%, #FF8E53 50%, #FFB347 100%);
  color: #fff;
  overflow: hidden;
}

.header-wave {
  position: absolute;
  bottom: -40rpx;
  left: -20rpx;
  right: -20rpx;
  height: 80rpx;
  background: var(--bg);
  border-radius: 50%;
}

.header-content {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 30rpx 50rpx;
  z-index: 1;
}

.logo-area {
  display: flex;
  align-items: center;
}

.logo-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  backdrop-filter: blur(10rpx);
}

.logo-text {
  font-size: 44rpx;
}

.brand-info {
  display: flex;
  flex-direction: column;
}

.company-name {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  line-height: 1.1;
}

.company-sub {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 4rpx;
}

.header-actions {
  display: flex;
}

.action-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 36rpx;
  backdrop-filter: blur(10rpx);
}

/* ========== 搜索框 ========== */
.search-container {
  padding: 20rpx 30rpx 30rpx;
  background: linear-gradient(160deg, #FF6B6B 0%, #FF8E53 50%, #FFB347 100%);
  margin-top: -1rpx;
}

.search-box {
  background: #fff;
  border-radius: 50rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.15);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 18rpx;
  opacity: 0.5;
}

.search-input {
  border: none;
  outline: none;
  width: 100%;
  font-size: 30rpx;
  color: var(--text);
}

.search-input::placeholder {
  color: #BDC3C7;
}

/* ========== 分类导航 ========== */
.category-bar {
  background: #fff;
  padding: 0 30rpx;
  border-bottom: 1rpx solid var(--border);
}

.category-inner {
  display: flex;
}

.category-item {
  position: relative;
  flex: 1;
  text-align: center;
  font-size: 29rpx;
  color: var(--text-secondary);
  padding: 28rpx 0;
  transition: color 0.25s;
}

.category-item.active {
  color: var(--primary);
  font-weight: 700;
}

.category-indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(to right, #FF6B6B, #FF8E53);
  border-radius: 3rpx;
}

/* ========== 筛选排序栏 ========== */
.filter-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--border);
  font-size: 27rpx;
  color: var(--text-secondary);
}

.sort-options {
  display: flex;
  gap: 20rpx;
}

.sort-option {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
  transition: background 0.2s;
}

.sort-arrow {
  font-size: 20rpx;
  color: var(--primary);
  font-weight: 700;
}

.filter-right {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.filter-btn {
  position: relative;
  display: flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border: 2rpx solid #E8DED8;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  background: #FAFAFA;
  transition: all 0.25s;
}

.filter-btn-active {
  border-color: var(--primary);
  color: var(--primary);
  background: #FFF5F0;
}

.filter-dot {
  position: absolute;
  top: 6rpx;
  right: 8rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #FF6B6B;
}

.product-count {
  color: #BDC3C7;
  font-size: 24rpx;
  white-space: nowrap;
}

.count-num {
  color: var(--primary);
  font-weight: 700;
  margin: 0 4rpx;
}

/* ========== 筛选面板 ========== */
.filter-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.35);
  z-index: 99;
}

.filter-panel {
  position: fixed;
  top: -100%;
  left: 0;
  right: 0;
  background: #fff;
  z-index: 100;
  padding: 30rpx;
  border-radius: 0 0 32rpx 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(0,0,0,0.12);
  transition: top 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}

.filter-panel-show {
  top: 0;
}

.filter-section {
  margin-bottom: 28rpx;
}

.filter-section-title {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 700;
  margin-bottom: 16rpx;
}

.filter-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.filter-tag {
  padding: 12rpx 28rpx;
  background: #F8F5F3;
  color: var(--text-secondary);
  border-radius: 32rpx;
  font-size: 26rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.filter-tag-active {
  background: linear-gradient(135deg, #FFF0EC, #FFE5DE);
  color: #FF6B6B;
  border-color: #FF6B6B;
}

.filter-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 30rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--border);
}

.filter-reset-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  background: #F8F5F3;
  color: var(--text-secondary);
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.filter-confirm-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  background: linear-gradient(135deg, #FF6B6B, #FF8E53);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 18rpx rgba(255, 107, 107, 0.3);
}

.product-grid {
  /* 使用网格布局（Grid）来排列商品卡片 */
  display: grid;
  /* 定义两列，每列宽度为可用空间的一份（1fr），实现等宽两列布局 */
  grid-template-columns: repeat(2, 1fr);  /* 两列等宽 */
  /* 设置网格项之间的行间距和列间距均为 20rpx（rpx 为微信小程序响应式单位） */
  gap: 20rpx;                             /* 网格间距 */
  /* 在网格容器内部四周添加 20rpx 的内边距，避免内容贴边 */
  padding: 20rpx;
}


/* ========== 加载中 ========== */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 180rpx 0;
}

.loading-spinner {
  width: 72rpx;
  height: 72rpx;
  border: 6rpx solid #F0EDEA;
  border-top-color: #FF6B6B;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #BDC3C7;
}

/* ========== 加载错误 ========== */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 180rpx 0;
}

.error-illustration {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.error-text {
  font-size: 30rpx;
  color: var(--text-secondary);
  font-weight: 600;
  margin-bottom: 10rpx;
}

.error-hint {
  font-size: 24rpx;
  color: #BDC3C7;
  margin-bottom: 32rpx;
}

.retry-btn {
  padding: 16rpx 56rpx;
  background: linear-gradient(135deg, #FF6B6B, #FF8E53);
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 180rpx 0;
}

.empty-illustration {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: var(--text-secondary);
  font-weight: 600;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #BDC3C7;
}

/* ========== 列表底部 ========== */
.list-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0 60rpx;
  font-size: 24rpx;
  color: #BDC3C7;
}

.footer-loading {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.footer-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #F0EDEA;
  border-top-color: #FF6B6B;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.footer-end text {
  color: #D0C9C3;
}
