.page-container { padding-bottom: 40rpx; min-height: 100vh; background: #FFF5F0; }

/* ========== 钱包卡片 ========== */
.wallet-card { position: relative; margin: 24rpx; border-radius: 24rpx; overflow: hidden; }
.wallet-bg { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: linear-gradient(160deg, #FF6B6B 0%, #FF8E53 50%, #FFB347 100%); }
.wallet-content { position: relative; z-index: 1; padding: 40rpx 36rpx; display: flex; flex-direction: column; align-items: center; }
.wallet-label { font-size: 26rpx; color: rgba(255,255,255,0.8); margin-bottom: 12rpx; }
.wallet-balance { display: flex; align-items: baseline; margin-bottom: 12rpx; }
.balance-sign { font-size: 36rpx; color: #fff; font-weight: 700; }
.balance-num { font-size: 72rpx; color: #fff; font-weight: 700; margin-left: 4rpx; }
.wallet-hint { font-size: 22rpx; color: rgba(255,255,255,0.6); }

/* ========== 通用居中状态 ========== */
.center-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 120rpx 0; font-size: 28rpx; color: #BDC3C7; }
.error-icon, .empty-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.retry-btn { margin-top: 24rpx; padding: 14rpx 48rpx; background: linear-gradient(135deg, #FF6B6B, #FF8E53); color: #fff; border-radius: 36rpx; font-size: 26rpx; }
.spinner { width: 56rpx; height: 56rpx; border: 4rpx solid #F0EDEA; border-top-color: #FF6B6B; border-radius: 50%; animation: spin 0.8s linear infinite; margin-bottom: 20rpx; }
@keyframes spin { to { transform: rotate(360deg); } }

/* ========== 交易记录 ========== */
.section-title { font-size: 26rpx; color: #BDC3C7; font-weight: 600; padding: 20rpx 24rpx 8rpx; }
.tx-list { margin: 0 24rpx; background: #fff; border-radius: 16rpx; overflow: hidden; }
.tx-item { display: flex; justify-content: space-between; align-items: center; padding: 24rpx; border-bottom: 1rpx solid #F8F0EB; }
.tx-item:last-child { border-bottom: none; }
.tx-left { display: flex; flex-direction: column; gap: 6rpx; flex: 1; overflow: hidden; }
.tx-desc { font-size: 28rpx; color: #2D3436; font-weight: 500; }
.tx-time { font-size: 22rpx; color: #BDC3C7; }
.tx-amount { font-size: 30rpx; font-weight: 700; flex-shrink: 0; margin-left: 16rpx; }
.tx-plus { color: #27AE60; }
.tx-minus { color: #FF6B6B; }

.list-footer { text-align: center; padding: 24rpx 0; font-size: 24rpx; color: #BDC3C7; }
