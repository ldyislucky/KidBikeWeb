<view class="detail-page">
  <!-- 加载中 -->
  <view class="detail-loading" wx:if="{{loading}}">
    <view class="detail-spinner"></view>
    <text>加载中...</text>
  </view>

  <!-- 加载错误 -->
  <view class="detail-error" wx:elif="{{loadError}}">
    <text class="error-icon">😵</text>
    <text>加载失败，请重试</text>
  </view>

  <block wx:else>
    <!-- 产品轮播图 -->
    <view class="detail-image-wrap">
      <swiper
        class="detail-swiper"
        indicator-dots="{{false}}"
        autoplay="{{false}}"
        circular="{{true}}"
        current="{{currentSwiper}}"
        bindchange="onSwiperChange"
      >
        <swiper-item wx:for="{{imageUrls}}" wx:key="index">
          <image
            class="detail-image"
            src="{{imgLoadErrors[index] ? '/static/images/default-product.png' : item}}"
            mode="aspectFill"
            data-idx="{{index}}"
            binderror="onImageError"
          />
        </swiper-item>
      </swiper>
      <!-- 自定义指示点 -->
      <view class="swiper-dots" wx:if="{{imageUrls.length > 1}}">
        <view
          class="swiper-dot {{currentSwiper === index ? 'active' : ''}}"
          wx:for="{{imageUrls}}"
          wx:key="index"
        ></view>
      </view>
      <view class="image-badge image-badge-rec" wx:if="{{product.isRecommend}}">推荐</view>
      <view class="image-badge image-badge-stock" wx:if="{{!product.isInStock}}">预售</view>
    </view>

    <!-- 产品信息卡片 -->
    <view class="detail-card">
      <view class="detail-title">{{product.title}}</view>

      <view class="detail-price-row">
        <text class="detail-price-sign">¥</text>
        <text class="detail-price-num">{{product.price}}</text>
      </view>

      <view class="detail-divider"></view>

      <view class="detail-info-grid">
        <view class="info-item">
          <text class="info-label">货号</text>
          <text class="info-value">{{product.itemNo}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">更新时间</text>
          <text class="info-value">{{product.updateTime}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">推荐状态</text>
          <text class="info-value {{product.isRecommend ? 'tag-rec' : ''}}">{{product.isRecommend ? '主推产品' : '常规产品'}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">库存状态</text>
          <text class="info-value {{product.isInStock ? 'tag-stock' : 'tag-pre'}}">{{product.isInStock ? '现货供应' : '预售中'}}</text>
        </view>
      </view>
    </view>

    <!-- 产品描述 -->
    <view class="detail-card" wx:if="{{product.description}}">
      <view class="section-title">产品介绍</view>
      <view class="section-content">
        <text>{{product.description}}</text>
      </view>
    </view>

    <!-- 底部操作栏 -->
    <view class="detail-footer">
      <view class="footer-btn footer-btn-fav {{isFavorited ? 'favorited' : ''}}" bindtap="onToggleFavorite">
        <text>{{isFavorited ? '❤️ 已收藏' : '🤍 收藏'}}</text>
      </view>
      <view class="footer-btn footer-btn-contact" bindtap="onContact">
        <text>联系客服</text>
      </view>
      <!-- 管理员：更多操作 -->
      <view class="footer-btn footer-btn-more" wx:if="{{isAdmin}}" bindtap="onShowMore">
        <text>···</text>
      </view>
    </view>

    <!-- 管理员操作弹窗 -->
    <view class="admin-action-mask" wx:if="{{showAdminAction}}" bindtap="onHideMore">
      <view class="admin-action-sheet" catchtap="noop">
        <view class="admin-action-item admin-action-update" bindtap="onAdminUpdate">
          <text class="admin-action-icon">✏️</text>
          <text class="admin-action-text">更新产品</text>
        </view>
        <view class="admin-action-divider"></view>
        <view class="admin-action-item admin-action-delete" bindtap="onAdminDelete">
          <text class="admin-action-icon">🗑️</text>
          <text class="admin-action-text">删除产品</text>
        </view>
      </view>
    </view>
  </block>
</view>
