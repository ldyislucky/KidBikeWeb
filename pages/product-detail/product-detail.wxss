.detail-page {
  padding-bottom: 140rpx;
  background: #FFF5F0;
  min-height: 100vh;
}

/* ========== 加载/错误状态 ========== */
.detail-loading,
.detail-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 300rpx;
  font-size: 28rpx;
  color: #BDC3C7;
}

.detail-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 5rpx solid #F0EDEA;
  border-top-color: #FF6B6B;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.detail-error .error-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

/* ========== 产品大图 ========== */
.detail-image-wrap {
  position: relative;
  width: 100%;
  height: 560rpx;
  overflow: hidden;
  background: linear-gradient(160deg, #FFF0EC, #FFE0D6);
}

.detail-image {
  width: 100%;
  height: 100%;
}

.image-badge {
  position: absolute;
  z-index: 2;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  padding: 8rpx 22rpx;
  border-radius: 24rpx;
}

.image-badge-rec {
  top: 24rpx;
  left: 24rpx;
  background: linear-gradient(135deg, #FF6B6B, #FF8E53);
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.4);
}

.image-badge-stock {
  top: 24rpx;
  right: 24rpx;
  background: rgba(255, 177, 66, 0.92);
}

/* ========== 信息卡片 ========== */
.detail-card {
  background: #fff;
  margin: 20rpx 24rpx;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 107, 0.06);
}

.detail-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2D3436;
  line-height: 1.4;
  margin-bottom: 20rpx;
}

.detail-price-row {
  display: flex;
  align-items: baseline;
}

.detail-price-sign {
  font-size: 30rpx;
  color: #FF6B6B;
  font-weight: 700;
}

.detail-price-num {
  font-size: 52rpx;
  color: #FF6B6B;
  font-weight: 700;
  margin-left: 4rpx;
}

.detail-divider {
  height: 1rpx;
  background: #F8F0EB;
  margin: 24rpx 0;
}

/* ========== 信息网格 ========== */
.detail-info-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.info-label {
  font-size: 26rpx;
  color: #B2BEC3;
}

.info-value {
  font-size: 26rpx;
  color: #2D3436;
  font-weight: 500;
}

.tag-rec {
  color: #FF6B6B !important;
}

.tag-stock {
  color: #00B894 !important;
}

.tag-pre {
  color: #F39C12 !important;
}

/* ========== 产品介绍 ========== */
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2D3436;
  margin-bottom: 16rpx;
}

.section-content {
  font-size: 26rpx;
  color: #636E72;
  line-height: 1.8;
}

/* ========== 底部操作栏 ========== */
.detail-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 20rpx rgba(0, 0, 0, 0.05);
  gap: 20rpx;
}

.footer-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.footer-btn-fav {
  flex: 0.8;
  background: #FFF5F0;
  color: #FF6B6B;
  border: 2rpx solid #FFE0D6;
  font-size: 26rpx;
}

.footer-btn-fav.favorited {
  background: #FFF0EC;
  border-color: #FF6B6B;
}

.footer-btn-contact {
  flex: 1;
  background: linear-gradient(135deg, #FF6B6B, #FF8E53);
  color: #fff;
  box-shadow: 0 6rpx 18rpx rgba(255, 107, 107, 0.3);
}
