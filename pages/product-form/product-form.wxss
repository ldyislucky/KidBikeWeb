/* ========== 表单卡片 ========== */
.form-card {
  background: #fff;
  margin: 24rpx 30rpx;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 107, 0.05);
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F8F0EB;
}

.card-header-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.card-header-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

/* ========== 图片上传 ========== */
.image-upload {
  display: flex;
  justify-content: center;
}

.upload-placeholder {
  width: 320rpx;
  height: 320rpx;
  border: 4rpx dashed #E8DED8;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #FFFAF8;
  transition: border-color 0.2s;
}

.upload-icon {
  font-size: 80rpx;
  color: #D0C8C0;
  line-height: 1;
  font-weight: 300;
}

.upload-hint {
  font-size: 24rpx;
  color: #BDC3C7;
  margin-top: 16rpx;
}

.preview-image {
  width: 320rpx;
  height: 320rpx;
  border-radius: 20rpx;
  border: 2rpx solid #F0E4DC;
}

/* ========== 表单项 ========== */
.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F8F0EB;
}

.form-item.no-border {
  border-bottom: none;
}

.form-label {
  width: 160rpx;
  font-size: 28rpx;
  color: var(--text);
  font-weight: 500;
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.required {
  color: #FF6B6B;
  margin-left: 4rpx;
  font-weight: 700;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
  color: var(--text);
}

.form-input::placeholder {
  color: #BDC3C7;
}

.price-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.price-prefix {
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 700;
  margin-right: 6rpx;
}

.price-input {
  flex: unset;
  width: 200rpx;
}

/* ========== 开关行 ========== */
.switch-row {
  justify-content: space-between;
}

.switch-info {
  display: flex;
  flex-direction: column;
}

.switch-label {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 500;
}

.switch-desc {
  font-size: 22rpx;
  color: #BDC3C7;
  margin-top: 6rpx;
}

/* ========== 提交按钮 ========== */
.submit-section {
  padding: 40rpx 30rpx 80rpx;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FF6B6B, #FF8E53);
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.3);
}

.submit-text {
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
