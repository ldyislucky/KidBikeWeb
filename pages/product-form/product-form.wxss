/* ========== 表单卡片 ========== */
.form-card {
  background: #fff;
  margin: 24rpx 30rpx;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 107, 0.05);
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F8F0EB;
}

.card-header-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.card-header-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

.card-header-sub {
  font-size: 22rpx;
  color: #BDC3C7;
  margin-left: 8rpx;
}

/* ========== 图片上传 ========== */
.image-upload {
  display: flex;
  justify-content: center;
}

.upload-placeholder {
  width: 320rpx;
  height: 320rpx;
  border: 4rpx dashed #E8DED8;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #FFFAF8;
}

.upload-icon {
  font-size: 80rpx;
  color: #D0C8C0;
  line-height: 1;
  font-weight: 300;
}

.upload-hint {
  font-size: 24rpx;
  color: #BDC3C7;
  margin-top: 16rpx;
}

.upload-hint-sub {
  font-size: 20rpx;
  color: #D0C8C0;
  margin-top: 8rpx;
}

/* 已选图片 */
.preview-wrap {
  position: relative;
  width: 320rpx;
  height: 320rpx;
}

.preview-image {
  width: 320rpx;
  height: 320rpx;
  border-radius: 20rpx;
  border: 2rpx solid #F0E4DC;
}

/* 上传中 / 失败 遮罩 */
.upload-overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.52);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-overlay-fail {
  background: rgba(255, 68, 68, 0.65);
}

.upload-overlay-icon {
  font-size: 48rpx;
  color: #fff;
  font-weight: 700;
  line-height: 1;
}

.upload-overlay-text {
  font-size: 26rpx;
  color: #fff;
  margin-top: 12rpx;
}

.upload-retry-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 6rpx;
}

/* 上传成功重选提示 */
.upload-reselect-tip {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  background: rgba(0, 0, 0, 0.45);
  border-radius: 0 0 20rpx 20rpx;
  padding: 10rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-reselect-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* ========== 表单项 ========== */
.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F8F0EB;
}

.form-item.no-border {
  border-bottom: none;
}

.form-label {
  width: 160rpx;
  font-size: 28rpx;
  color: var(--text);
  font-weight: 500;
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.required {
  color: #FF6B6B;
  margin-left: 4rpx;
  font-weight: 700;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
  color: var(--text);
}

.form-input::placeholder {
  color: #BDC3C7;
}

.price-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.price-prefix {
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 700;
  margin-right: 6rpx;
}

.price-input {
  flex: unset;
  width: 200rpx;
}

/* ========== 产品描述文本域 ========== */
.desc-textarea {
  width: 100%;
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.7;
  min-height: 160rpx;
  box-sizing: border-box;
}

.desc-textarea::placeholder {
  color: #BDC3C7;
}

.desc-count {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
}

.desc-count-text {
  font-size: 22rpx;
  color: #BDC3C7;
}

/* ========== 开关行 ========== */
.switch-row {
  justify-content: space-between;
}

.switch-info {
  display: flex;
  flex-direction: column;
}

.switch-label {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 500;
}

.switch-desc {
  font-size: 22rpx;
  color: #BDC3C7;
  margin-top: 6rpx;
}

/* ========== 提交按钮 ========== */
.submit-section {
  padding: 40rpx 30rpx 80rpx;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FF6B6B, #FF8E53);
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.3);
}

.submit-btn-disabled {
  opacity: 0.6;
}

.submit-text {
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
