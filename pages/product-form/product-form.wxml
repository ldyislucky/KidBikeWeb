<view hidden="{{!pageReady}}">

<!-- 产品图片上传 -->
<view class="form-card">
  <view class="card-header">
    <text class="card-header-icon">📸</text>
    <text class="card-header-title">产品图片</text>
    <text class="card-header-sub">（选填，支持 JPG/PNG）</text>
  </view>
  <view class="image-upload" bindtap="onChooseImage">
    <!-- 已选图片（仅预览，提交时才上传） -->
    <view wx:if="{{productImage}}" class="preview-wrap">
      <image class="preview-image" src="{{productImage}}" mode="aspectFill"></image>
      <view class="upload-reselect-tip">
        <text class="upload-reselect-text">✓ 点击重新选择</text>
      </view>
    </view>
    <!-- 未选图片 -->
    <view wx:else class="upload-placeholder">
      <text class="upload-icon">+</text>
      <text class="upload-hint">点击上传产品图片</text>
      <text class="upload-hint-sub">从相册选择或拍摄</text>
    </view>
  </view>
</view>

<!-- 基本信息 -->
<view class="form-card">
  <view class="card-header">
    <text class="card-header-icon">📋</text>
    <text class="card-header-title">基本信息</text>
  </view>
  <view class="form-item">
    <view class="form-label">
      <text>产品名称</text>
      <text class="required">*</text>
    </view>
    <input class="form-input" placeholder="请输入产品名称" value="{{title}}" bindinput="onTitleInput" />
  </view>
  <view class="form-item">
    <view class="form-label">
      <text>货号</text>
      <text class="required">*</text>
    </view>
    <input class="form-input" placeholder="如 BK-001" value="{{itemNo}}" bindinput="onItemNoInput" />
  </view>
  <view class="form-item no-border">
    <view class="form-label">
      <text>价格</text>
      <text class="required">*</text>
    </view>
    <view class="price-input-wrap">
      <text class="price-prefix">¥</text>
      <input class="form-input price-input" type="digit" placeholder="请输入价格" value="{{price}}" bindinput="onPriceInput" />
    </view>
  </view>
</view>

<!-- 产品描述 -->
<view class="form-card">
  <view class="card-header">
    <text class="card-header-icon">📝</text>
    <text class="card-header-title">产品描述</text>
    <text class="card-header-sub">（选填）</text>
  </view>
  <textarea
    class="desc-textarea"
    placeholder="请输入产品描述，如材质、规格、适用年龄等..."
    value="{{description}}"
    bindinput="onDescriptionInput"
    maxlength="500"
    auto-height
  ></textarea>
  <view class="desc-count">
    <text class="desc-count-text">{{description.length}}/500</text>
  </view>
</view>

<!-- 产品属性 -->
<view class="form-card">
  <view class="card-header">
    <text class="card-header-icon">🏷️</text>
    <text class="card-header-title">产品属性</text>
  </view>
  <view class="form-item switch-row">
    <view class="switch-info">
      <text class="switch-label">主推产品</text>
      <text class="switch-desc">开启后将在首页主推栏目展示</text>
    </view>
    <switch checked="{{isRecommend}}" bindchange="onRecommendChange" color="#FF6B6B" />
  </view>
  <view class="form-item switch-row no-border">
    <view class="switch-info">
      <text class="switch-label">现货产品</text>
      <text class="switch-desc">标记该产品为现货状态</text>
    </view>
    <switch checked="{{isInStock}}" bindchange="onInStockChange" color="#FF6B6B" />
  </view>
</view>

<!-- 提交按钮 -->
<view class="submit-section">
  <view class="submit-btn {{submitting ? 'submit-btn-disabled' : ''}}" bindtap="onSubmit">
    <text class="submit-text">{{submitting ? '提交中...' : '提交产品'}}</text>
  </view>
</view>

</view>
