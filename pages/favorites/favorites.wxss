.page-container { padding-bottom: 40rpx; min-height: 100vh; background: #FFF5F0; }

/* ========== 通用居中状态 ========== */
.center-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 160rpx 0; font-size: 28rpx; color: #BDC3C7; }
.error-icon, .empty-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.hint-text { font-size: 24rpx; margin-top: 8rpx; }
.retry-btn { margin-top: 24rpx; padding: 14rpx 48rpx; background: linear-gradient(135deg, #FF6B6B, #FF8E53); color: #fff; border-radius: 36rpx; font-size: 26rpx; }
.spinner { width: 56rpx; height: 56rpx; border: 4rpx solid #F0EDEA; border-top-color: #FF6B6B; border-radius: 50%; animation: spin 0.8s linear infinite; margin-bottom: 20rpx; }
@keyframes spin { to { transform: rotate(360deg); } }

/* ========== 收藏卡片 ========== */
.fav-list { padding: 20rpx 24rpx; }
.fav-card { display: flex; align-items: center; background: #fff; border-radius: 16rpx; padding: 20rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 12rpx rgba(255,107,107,0.04); }
.fav-img { width: 120rpx; height: 120rpx; border-radius: 12rpx; background: #FFF0EC; flex-shrink: 0; }
.fav-info { flex: 1; margin-left: 20rpx; display: flex; flex-direction: column; gap: 10rpx; overflow: hidden; }
.fav-title { font-size: 28rpx; color: #2D3436; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.fav-price { font-size: 30rpx; color: #FF6B6B; font-weight: 700; }
.fav-remove { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; font-size: 36rpx; color: #BDC3C7; flex-shrink: 0; }

.list-footer { text-align: center; padding: 24rpx 0; font-size: 24rpx; color: #BDC3C7; }
