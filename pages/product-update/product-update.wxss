/* ========== 页面容器 ========== */
.page-container {
  min-height: 100vh;
  background: var(--bg, #FFF5F0);
  padding-bottom: 40rpx;
}

/* ========== 状态提示 ========== */
.state-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.state-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.state-text {
  font-size: 30rpx;
  color: #999;
}

.retry-btn {
  margin-top: 30rpx;
  padding: 16rpx 48rpx;
  background: linear-gradient(135deg, #FF6B6B, #FF8E53);
  border-radius: 36rpx;
}

.retry-btn text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

/* ========== 表单卡片 ========== */
.form-card {
  background: #fff;
  margin: 24rpx 30rpx;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 107, 0.05);
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F8F0EB;
}

.card-header-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.card-header-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text, #2D3436);
}

.card-header-sub {
  font-size: 22rpx;
  color: #BDC3C7;
  margin-left: 8rpx;
}

/* ========== 图片宫格 ========== */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 210rpx;
  height: 210rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.image-thumb {
  width: 100%;
  height: 100%;
}

/* 本地暂存图片标识 */
.image-local-badge {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  background: rgba(255, 107, 107, 0.85);
  color: #fff;
  font-size: 18rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.image-delete-btn {
  position: absolute;
  top: 0;
  right: 0;
  width: 48rpx;
  height: 48rpx;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 0 0 16rpx;
}

.image-delete-icon {
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.image-add-btn {
  width: 210rpx;
  height: 210rpx;
  border-radius: 20rpx;
  border: 4rpx dashed #E8DED8;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #FFFAF8;
}

.add-icon-text {
  font-size: 56rpx;
  color: #D0C8C0;
  line-height: 1;
  font-weight: 300;
}

.add-hint-text {
  font-size: 22rpx;
  color: #BDC3C7;
  margin-top: 8rpx;
}

.image-full-tip {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #F39C12;
}

/* ========== 表单项 ========== */
.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F8F0EB;
}

.form-item.no-border {
  border-bottom: none;
}

.form-label {
  width: 160rpx;
  font-size: 28rpx;
  color: var(--text, #2D3436);
  font-weight: 500;
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.required {
  color: #FF6B6B;
  margin-left: 4rpx;
  font-weight: 700;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
  color: var(--text, #2D3436);
}

.form-input::placeholder {
  color: #BDC3C7;
}

/* ========== 价格输入 ========== */
.price-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.price-prefix {
  font-size: 28rpx;
  color: var(--primary, #FF6B6B);
  font-weight: 700;
  margin-right: 6rpx;
}

.price-input {
  flex: unset;
  width: 200rpx;
}

/* ========== 描述文本域 ========== */
.desc-textarea {
  width: 100%;
  font-size: 28rpx;
  color: var(--text, #2D3436);
  line-height: 1.7;
  min-height: 160rpx;
  box-sizing: border-box;
}

.desc-textarea::placeholder {
  color: #BDC3C7;
}

.desc-counter {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
}

.desc-counter text {
  font-size: 22rpx;
  color: #BDC3C7;
}

/* ========== 开关行 ========== */
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F8F0EB;
}

.switch-row:last-child {
  border-bottom: none;
}

.switch-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  margin-right: 20rpx;
}

.switch-label {
  font-size: 28rpx;
  color: var(--text, #2D3436);
  font-weight: 500;
}

.switch-desc {
  font-size: 22rpx;
  color: #BDC3C7;
  margin-top: 6rpx;
}

/* ========== 提交按钮 ========== */
.submit-section {
  padding: 40rpx 30rpx 80rpx;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FF6B6B, #FF8E53);
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.3);
}

.submit-btn.submitting {
  opacity: 0.6;
}

.submit-text {
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.bottom-placeholder {
  height: 40rpx;
}
