<!-- 用户头部 -->
<view class="user-header">
  <view class="user-bg">
    <view class="bg-circle bg-circle-1"></view>
    <view class="bg-circle bg-circle-2"></view>
  </view>
  <view class="user-info">

    <!-- 未登录：整块区域可点击，跳转登录页 -->
    <view class="user-unlogin-block" wx:if="{{!userInfo.isLogin}}" bindtap="onLogin">
      <image class="avatar avatar-unlogin" src="/static/images/default-avatar.png" mode="aspectFill"></image>
      <view class="avatar-glow"></view>
      <text class="nickname unlogin-nickname">点击登录</text>
      <text class="unlogin-hint">登录后享受完整服务 ›</text>
    </view>

    <!-- 已登录：展示头像 + 昵称 -->
    <view class="avatar-wrap" wx:else>
      <image class="avatar" src="{{userInfo.avatar || '/static/images/default-avatar.png'}}" mode="aspectFill"></image>
      <view class="avatar-glow"></view>
    </view>
    <view class="nickname" wx:if="{{userInfo.isLogin}}">{{userInfo.nickName}}</view>
    <view class="user-tag" wx:if="{{userInfo.isLogin}}">已认证用户</view>

  </view>
</view>

<!-- 功能菜单 -->
<view class="menu-section">
  <view class="menu-title">常用功能</view>
  <view class="menu-card">
    <view
      wx:for="{{menuList}}"
      wx:key="id"
      class="menu-item"
      data-id="{{item.id}}"
      bindtap="onMenuTap"
    >
      <view class="menu-left">
        <view class="menu-icon-wrap">
          <text class="menu-icon iconfont {{item.icon}}"></text>
        </view>
        <text class="menu-text">{{item.title}}</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</view>

<!-- 产品管理（仅登录且为管理员时显示） -->
<view class="menu-section" wx:if="{{userInfo.isLogin && userInfo.isAdmin}}">
  <view class="menu-title">产品管理</view>
  <view class="menu-card">
    <!-- 新增产品 -->
    <view class="menu-item add-item" bindtap="onAddProduct">
      <view class="menu-left">
        <view class="menu-icon-wrap add-icon">
          <text class="menu-icon iconfont icon-a-024_bianji-37"></text>
        </view>
        <view class="add-info">
          <text class="menu-text">新增产品</text>
          <text class="menu-sub">发布新的自行车产品</text>
        </view>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</view>

<!-- 退出登录（已登录时显示） -->
<view class="logout-section" wx:if="{{userInfo.isLogin}}">
  <view class="logout-btn" bindtap="onLogout">
    <text class="logout-text">退出登录</text>
  </view>
</view>

<!-- 底部信息 -->
<view class="footer-info">
  <view class="footer-brand">🚲 KidBike 儿童自行车</view>
  <text class="footer-ver">v1.0.0</text>
</view>
