/* ========== 用户头部 ========== */
.user-header {
  position: relative;
  padding-bottom: 30rpx;
}

.user-bg {
  position: relative;
  height: 280rpx;
  background: linear-gradient(160deg, #FF6B6B 0%, #FF8E53 50%, #FFB347 100%);
  overflow: hidden;
}

.bg-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255,255,255,0.08);
}

.bg-circle-1 {
  width: 200rpx;
  height: 200rpx;
  top: -60rpx;
  right: -40rpx;
}

.bg-circle-2 {
  width: 120rpx;
  height: 120rpx;
  bottom: -30rpx;
  left: 30rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: -90rpx;
  position: relative;
  z-index: 1;
}

/* ========== 未登录整块可点击区域 ========== */
.user-unlogin-block {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-unlogin {
  opacity: 0.8;
}

.unlogin-nickname {
  /* 复用 .nickname 的样式，通过额外类名控制颜色 */
  color: var(--text, #2C2C2C) !important;
}

.unlogin-hint {
  font-size: 24rpx;
  color: #FF8E53;
  margin-top: 8rpx;
  background: rgba(255, 142, 83, 0.1);
  padding: 6rpx 24rpx;
  border-radius: 20rpx;
}

/* ========== 已登录头像 ========== */
.avatar-wrap {
  position: relative;
}

.avatar {
  width: 170rpx;
  height: 170rpx;
  border-radius: 50%;
  border: 6rpx solid #fff;
  background-color: #F0E4DC;
  box-shadow: 0 8rpx 30rpx rgba(255, 107, 107, 0.15);
}

.avatar-glow {
  position: absolute;
  top: -8rpx;
  left: -8rpx;
  right: -8rpx;
  bottom: -8rpx;
  border-radius: 50%;
  background: transparent;
  border: 3rpx solid rgba(255, 107, 107, 0.25);
}

.nickname {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text);
  margin-top: 20rpx;
}

.user-tag {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #FF6B6B;
  background: #FFF0EC;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

/* ========== 菜单区 ========== */
.menu-section {
  padding: 0 30rpx;
  margin-bottom: 8rpx;
}

.menu-title {
  font-size: 24rpx;
  color: #BDC3C7;
  font-weight: 600;
  padding: 20rpx 0 14rpx;
  letter-spacing: 1rpx;
}

.menu-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 107, 0.04);
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid #F8F0EB;
  transition: background 0.15s;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  background: #FFF5F0;
}

.add-icon {
  background: linear-gradient(135deg, #FFF0EC, #FFE5DE);
}

.delete-icon {
  background: linear-gradient(135deg, #FFF5F5, #FFE5E5);
}

.delete-icon .menu-icon {
  color: #FF4444;
}

.menu-icon {
  font-size: 34rpx;
  color: #FF6B6B;
}

.menu-text {
  font-size: 30rpx;
  color: var(--text);
  font-weight: 500;
}

.add-info {
  display: flex;
  flex-direction: column;
}

.menu-sub {
  font-size: 22rpx;
  color: #BDC3C7;
  margin-top: 4rpx;
}

.menu-arrow {
  font-size: 36rpx;
  color: #D0C8C0;
  font-weight: 300;
}

/* ========== 退出登录 ========== */
.logout-section {
  padding: 20rpx 30rpx 0;
}

.logout-btn {
  background: #fff;
  border-radius: 20rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 107, 0.06);
}

.logout-text {
  font-size: 30rpx;
  color: #FF6B6B;
  font-weight: 600;
}

/* ========== 底部信息 ========== */
.footer-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 40rpx;
}

.footer-brand {
  font-size: 26rpx;
  color: #BDC3C7;
  margin-bottom: 8rpx;
}

.footer-ver {
  font-size: 22rpx;
  color: #D0C8C0;
}

/* ========== 删除产品弹窗 ========== */
.del-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.del-modal-card {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.del-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 36rpx 24rpx;
  border-bottom: 1rpx solid #F5F0EB;
}

.del-modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2C2C2C;
}

.del-modal-close {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #BDC3C7;
  background: #F5F5F5;
  border-radius: 50%;
}

.del-modal-loading,
.del-modal-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.del-loading-text,
.del-empty-text {
  font-size: 28rpx;
  color: #BDC3C7;
}

.del-product-list {
  flex: 1;
  overflow: hidden;
  max-height: calc(80vh - 120rpx);
  padding: 0 30rpx 20rpx;
}

.del-product-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F8F0EB;
}

.del-product-item:last-child {
  border-bottom: none;
}

.del-product-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
  background: #F5F0EB;
  flex-shrink: 0;
}

.del-product-info {
  flex: 1;
  padding: 0 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  overflow: hidden;
}

.del-product-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C2C2C;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.del-product-price {
  font-size: 24rpx;
  color: #FF6B6B;
  margin-top: 6rpx;
}

.del-product-btn {
  flex-shrink: 0;
  background: #FFF0F0;
  border: 1rpx solid #FFCCCC;
  border-radius: 20rpx;
  padding: 10rpx 28rpx;
}

.del-product-btn-text {
  font-size: 24rpx;
  color: #FF4444;
  font-weight: 600;
}
