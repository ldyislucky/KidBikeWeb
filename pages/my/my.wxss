/* ========== 用户头部 ========== */
.user-header {
  position: relative;
  padding-bottom: 30rpx;
}

.user-bg {
  position: relative;
  height: 280rpx;
  background: linear-gradient(160deg, #FF6B6B 0%, #FF8E53 50%, #FFB347 100%);
  overflow: hidden;
}

.bg-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255,255,255,0.08);
}

.bg-circle-1 {
  width: 200rpx;
  height: 200rpx;
  top: -60rpx;
  right: -40rpx;
}

.bg-circle-2 {
  width: 120rpx;
  height: 120rpx;
  bottom: -30rpx;
  left: 30rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: -90rpx;
  position: relative;
  z-index: 1;
}

.avatar-btn {
  background: none;
  border: none;
  padding: 0;
  margin: 0;
  line-height: 1;
  position: relative;
}

.avatar-btn::after {
  border: none;
}

.avatar-wrap {
  position: relative;
}

.avatar {
  width: 170rpx;
  height: 170rpx;
  border-radius: 50%;
  border: 6rpx solid #fff;
  background-color: #F0E4DC;
  box-shadow: 0 8rpx 30rpx rgba(255, 107, 107, 0.15);
}

.avatar-glow {
  position: absolute;
  top: -8rpx;
  left: -8rpx;
  right: -8rpx;
  bottom: -8rpx;
  border-radius: 50%;
  background: transparent;
  border: 3rpx solid rgba(255, 107, 107, 0.25);
}

.nickname {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text);
  margin-top: 20rpx;
}

.user-tag {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #FF6B6B;
  background: #FFF0EC;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

/* ========== 菜单区 ========== */
.menu-section {
  padding: 0 30rpx;
  margin-bottom: 8rpx;
}

.menu-title {
  font-size: 24rpx;
  color: #BDC3C7;
  font-weight: 600;
  padding: 20rpx 0 14rpx;
  letter-spacing: 1rpx;
}

.menu-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 107, 0.04);
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid #F8F0EB;
  transition: background 0.15s;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  background: #FFF5F0;
}

.add-icon {
  background: linear-gradient(135deg, #FFF0EC, #FFE5DE);
}

.menu-icon {
  font-size: 34rpx;
  color: #FF6B6B;
}

.menu-text {
  font-size: 30rpx;
  color: var(--text);
  font-weight: 500;
}

.add-info {
  display: flex;
  flex-direction: column;
}

.menu-sub {
  font-size: 22rpx;
  color: #BDC3C7;
  margin-top: 4rpx;
}

.menu-arrow {
  font-size: 36rpx;
  color: #D0C8C0;
  font-weight: 300;
}

/* ========== 底部信息 ========== */
.footer-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 40rpx;
}

.footer-brand {
  font-size: 26rpx;
  color: #BDC3C7;
  margin-bottom: 8rpx;
}

.footer-ver {
  font-size: 22rpx;
  color: #D0C8C0;
}
