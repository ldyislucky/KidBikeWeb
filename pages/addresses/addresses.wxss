.page-container { padding-bottom: 120rpx; min-height: 100vh; background: #FFF5F0; }

/* ========== 选择模式 ========== */
.select-banner { background: linear-gradient(135deg, #FFF0EC, #FFE5DE); padding: 20rpx 24rpx; text-align: center; font-size: 26rpx; color: #FF6B6B; font-weight: 600; }

/* ========== 通用居中状态 ========== */
.center-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 160rpx 0; font-size: 28rpx; color: #BDC3C7; }
.error-icon, .empty-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.hint-text { font-size: 24rpx; margin-top: 8rpx; }
.retry-btn { margin-top: 24rpx; padding: 14rpx 48rpx; background: linear-gradient(135deg, #FF6B6B, #FF8E53); color: #fff; border-radius: 36rpx; font-size: 26rpx; }
.spinner { width: 56rpx; height: 56rpx; border: 4rpx solid #F0EDEA; border-top-color: #FF6B6B; border-radius: 50%; animation: spin 0.8s linear infinite; margin-bottom: 20rpx; }
@keyframes spin { to { transform: rotate(360deg); } }

/* ========== 地址卡片 ========== */
.addr-list { padding: 20rpx 24rpx; }
.addr-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 12rpx rgba(255,107,107,0.04); }
.addr-header { display: flex; align-items: center; margin-bottom: 10rpx; }
.addr-name { font-size: 30rpx; color: #2D3436; font-weight: 600; margin-right: 16rpx; }
.addr-phone { font-size: 26rpx; color: #636E72; margin-right: 12rpx; }
.addr-default { font-size: 20rpx; color: #FF6B6B; background: #FFF0EC; padding: 2rpx 12rpx; border-radius: 8rpx; }
.addr-detail { font-size: 26rpx; color: #636E72; line-height: 1.5; display: block; }
.addr-actions { display: flex; justify-content: flex-end; gap: 32rpx; margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #F8F0EB; }
.addr-edit { font-size: 26rpx; color: #FF6B6B; }
.addr-delete { font-size: 26rpx; color: #BDC3C7; }

/* ========== 新增按钮 ========== */
.add-addr-btn { position: fixed; bottom: 40rpx; left: 48rpx; right: 48rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #FF6B6B, #FF8E53); color: #fff; border-radius: 44rpx; font-size: 30rpx; font-weight: 600; box-shadow: 0 6rpx 20rpx rgba(255,107,107,0.3); }

/* ========== 表单弹窗 ========== */
.form-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.4); z-index: 99; }
.form-panel { position: fixed; bottom: -100%; left: 0; right: 0; background: #fff; z-index: 100; border-radius: 32rpx 32rpx 0 0; padding: 32rpx 30rpx; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); transition: bottom 0.3s ease; max-height: 80vh; overflow-y: auto; }
.form-panel-show { bottom: 0; }
.form-title { font-size: 32rpx; font-weight: 700; color: #2D3436; text-align: center; margin-bottom: 24rpx; }
.form-body { display: flex; flex-direction: column; gap: 20rpx; }
.addr-input { background: #F8F5F3; border-radius: 12rpx; height: 80rpx; padding: 0 20rpx; font-size: 28rpx; color: #2D3436; }
.form-switch { display: flex; justify-content: space-between; align-items: center; font-size: 28rpx; color: #2D3436; padding: 8rpx 0; }
.form-actions { display: flex; gap: 20rpx; margin-top: 28rpx; }
.form-cancel { flex: 1; height: 80rpx; display: flex; align-items: center; justify-content: center; background: #F8F5F3; border-radius: 40rpx; font-size: 28rpx; color: #636E72; }
.form-confirm { flex: 1; height: 80rpx; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #FF6B6B, #FF8E53); border-radius: 40rpx; font-size: 28rpx; color: #fff; font-weight: 600; }
