<view class="page-container">
  <!-- 状态筛选 -->
  <scroll-view class="tabs-bar" scroll-x>
    <view
      wx:for="{{tabs}}"
      wx:key="value"
      class="tab-item {{item.active ? 'tab-active' : ''}}"
      data-value="{{item.value}}"
      bindtap="onTabTap"
    >{{item.label}}</view>
  </scroll-view>

  <!-- 加载中 -->
  <view class="center-state" wx:if="{{loading}}">
    <view class="spinner"></view>
    <text>加载中...</text>
  </view>

  <!-- 加载错误 -->
  <view class="center-state" wx:elif="{{loadError}}">
    <text class="error-icon">😵</text>
    <text>加载失败</text>
    <view class="retry-btn" bindtap="fetchOrders">重试</view>
  </view>

  <!-- 空状态 -->
  <view class="center-state" wx:elif="{{orders.length === 0}}">
    <text class="empty-icon">📭</text>
    <text>暂无订单</text>
  </view>

  <!-- 订单列表 -->
  <view class="order-list" wx:else>
    <view
      wx:for="{{orders}}"
      wx:key="id"
      class="order-card"
      data-id="{{item.id}}"
      bindtap="onOrderTap"
    >
      <view class="order-header">
        <text class="order-no">订单号：#{{item.id}}</text>
        <text class="order-status status-{{item.status}}">{{item.status === 'pending' ? '待确认' : item.status === 'confirmed' ? '已确认' : item.status === 'shipped' ? '配送中' : item.status === 'delivered' ? '已送达' : item.status === 'cancelled' ? '已取消' : item.status}}</text>
      </view>
      <view class="order-body">
        <text class="order-product">{{item.productTitle || (item.product && item.product.title) || '商品'}}</text>
        <text class="order-qty">x{{item.quantity || 1}}</text>
      </view>
      <view class="order-footer">
        <text class="order-time">{{item.createTime || item.createdAt || ''}}</text>
        <text class="order-amount">¥{{item.totalAmount || item.amount || '-'}}</text>
      </view>
    </view>
  </view>

  <!-- 列表底部 -->
  <view class="list-footer" wx:if="{{orders.length > 0}}">
    <text wx:if="{{loading}}">加载中...</text>
    <text wx:elif="{{!hasMore}}">— 已经到底了 —</text>
  </view>
</view>
