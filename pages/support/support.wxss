.page-container { padding-bottom: 40rpx; min-height: 100vh; background: #FFF5F0; }

/* ========== 客服信息卡片 ========== */
.contact-card { position: relative; margin: 24rpx; border-radius: 24rpx; overflow: hidden; }
.contact-bg { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: linear-gradient(160deg, #667EEA, #764BA2); }
.contact-content { position: relative; z-index: 1; padding: 36rpx; display: flex; flex-direction: column; align-items: center; }
.contact-icon { font-size: 56rpx; margin-bottom: 12rpx; }
.contact-label { font-size: 24rpx; color: rgba(255,255,255,0.7); margin-bottom: 8rpx; }
.contact-value { font-size: 44rpx; color: #fff; font-weight: 700; margin-bottom: 8rpx; }
.contact-hours { font-size: 22rpx; color: rgba(255,255,255,0.6); }

/* ========== 通用居中状态 ========== */
.center-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 160rpx 0; font-size: 28rpx; color: #BDC3C7; }
.empty-icon { font-size: 80rpx; margin-bottom: 16rpx; }

/* ========== 咨询表单 ========== */
.form-card { background: #fff; margin: 24rpx; border-radius: 20rpx; padding: 30rpx; box-shadow: 0 4rpx 20rpx rgba(255,107,107,0.05); }
.form-card-title { font-size: 30rpx; font-weight: 700; color: #2D3436; margin-bottom: 20rpx; }
.product-ref { display: flex; align-items: center; padding: 16rpx 20rpx; background: #FFF5F0; border-radius: 12rpx; margin-bottom: 20rpx; }
.ref-label { font-size: 26rpx; color: #636E72; flex-shrink: 0; }
.ref-value { font-size: 26rpx; color: #2D3436; font-weight: 500; }
.inquiry-input { background: #F8F5F3; border-radius: 12rpx; height: 80rpx; padding: 0 20rpx; font-size: 28rpx; margin-bottom: 16rpx; }
.inquiry-textarea { background: #F8F5F3; border-radius: 12rpx; width: 100%; height: 240rpx; padding: 20rpx; font-size: 28rpx; box-sizing: border-box; }
.submit-btn { margin-top: 24rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #FF6B6B, #FF8E53); border-radius: 44rpx; color: #fff; font-size: 30rpx; font-weight: 600; box-shadow: 0 6rpx 18rpx rgba(255,107,107,0.3); }
