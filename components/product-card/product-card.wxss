.product-card {
  width: calc(50% - 10rpx);
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 107, 0.06);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

/* 图片区 — 4:3 比例 */
.card-img-wrap {
  position: relative;
  width: 100%;
  padding-bottom: 120%;
  overflow: hidden;
  background: linear-gradient(135deg, #FFF0EC, #FFE8E0);
}

.card-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* 推荐标签 */
.badge-rec {
  position: absolute;
  top: 0;
  left: 0;
  background: linear-gradient(135deg, #FF6B6B, #FF8E53);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-bottom-right-radius: 14rpx;
  z-index: 2;
  box-shadow: 2rpx 2rpx 6rpx rgba(255, 107, 107, 0.3);
}

/* 预售标签 */
.badge-stock {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 4rpx 16rpx;
  border-radius: 24rpx;
  background: rgba(255, 177, 66, 0.92);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  z-index: 2;
}

/* 信息区 */
.card-body {
  padding: 16rpx 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.card-title {
  width: 100%;
  font-size: 28rpx;
  font-weight: 600;
  color: #2D3436;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 价格区 */
.card-price {
  display: flex;
  align-items: baseline;
}

.price-sign {
  font-size: 22rpx;
  color: #FF6B6B;
  font-weight: 700;
}

.price-num {
  font-size: 34rpx;
  color: #FF6B6B;
  font-weight: 700;
  margin-left: 2rpx;
}
