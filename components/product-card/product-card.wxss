/* 商品卡片容器 - 整体白色卡片风格 */
.product-card {
  background-color: #ffffff;
  border-radius: 24rpx;          /* 圆润的圆角 */
  overflow: hidden;               /* 保证圆角裁剪子元素 */
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05); /* 轻微阴影增加立体感 */
  transition: transform 0.2s ease, box-shadow 0.2s ease; /* 点击微动效 */
  margin: 0 0 16rpx 0;           /* 底部间距，配合父级网格也可 */
}

/* 可选：添加按压效果（需配合 bindtap 模拟，仅样式预留） */
.product-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 图片外层容器 */
.card-img-wrap {
  position: relative;             /* 为徽章定位提供参照 */
  width: 100%;
  padding-bottom: 100%;           /* 1:1 正方形比例，可根据需求改为 75% (4:3) */
  overflow: hidden;
  background-color: #f5f5f5;      /* 图片占位背景色 */
}

/* 商品图片 */
.card-img {
  position: absolute;             /* 绝对定位填满父容器 */
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;              /* 保证图片覆盖容器，与 mode="aspectFill" 一致 */
}

/* 通用徽章样式 */
.badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 6rpx 16rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #ffffff;
  border-radius: 32rpx;           /* 胶囊形状 */
  backdrop-filter: blur(8rpx);    /* 毛玻璃效果（可选） */
}

/* 推荐徽章 */
.badge-rec {
  left: 16rpx;
  background: linear-gradient(135deg, #ff9a3c, #ff6a00); /* 橙红渐变 */
  box-shadow: 0 2rpx 6rpx rgba(255, 106, 0, 0.3);
}

/* 库存徽章（通用） */
.badge-stock {
  left: auto;
  right: 16rpx;
}

/* 现货 */
.badge-in {
  background: linear-gradient(135deg, #00b894, #00a381);
  box-shadow: 0 2rpx 6rpx rgba(0, 184, 148, 0.3);
}

/* 预售 */
.badge-pre {
  background: linear-gradient(135deg, #6c5ce7, #4a3bb5);
  box-shadow: 0 2rpx 6rpx rgba(108, 92, 231, 0.3);
}

/* 卡片内容区域 */
.card-body {
  padding: 24rpx 20rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 商品标题 */
.card-title {
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.4;
  color: #222222;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;          /* 最多显示两行 */
  -webkit-box-orient: vertical;
  word-break: break-all;
}

/* 价格行 */
.card-price {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  color: #ff4d4f;                 /* 暖红色价格 */
}

/* 货币符号 */
.price-sign {
  font-size: 26rpx;
  font-weight: 600;
}

/* 价格数字 */
.price-num {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}

/* 可选：如果希望显示原价或销量等，可在此扩展 */