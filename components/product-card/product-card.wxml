<view class="product-card" bindtap="onTap">
  <view class="card-img-wrap">
    <image
      class="card-img"
      src="{{imgLoadError ? '/static/images/default-product.png' : imageUrl}}"
      mode="aspectFill"
      binderror="onImageError"
    />
    <view class="badge badge-rec" wx:if="{{product.is_recommend || product.isRecommend}}">推荐</view>
    <view class="badge badge-stock badge-in" wx:if="{{product.is_in_stock || product.isInStock}}">现货</view>
    <view class="badge badge-stock badge-pre" wx:else>预售</view>
  </view>
  <view class="card-body">
    <view class="card-title">{{product.title}}</view>
    <view class="card-price">
      <text class="price-sign">¥</text>
      <text class="price-num">{{product.price}}</text>
    </view>
  </view>
</view>
